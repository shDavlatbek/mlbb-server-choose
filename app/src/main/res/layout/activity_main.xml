<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/subtitle"
            android:textColor="@color/text2"
            android:textSize="14sp" />

        <!-- country -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/Label" android:text="@string/allowed_country" />
            <TextView
                android:id="@+id/countries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btn_country"
                    style="@style/TextButton"
                    android:text="@string/choose_country" />
                <Button
                    android:id="@+id/btn_city"
                    style="@style/TextButton"
                    android:layout_marginStart="8dp"
                    android:text="@string/choose_city" />
            </LinearLayout>
        </LinearLayout>

        <!-- mode -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/Label" android:text="@string/mode_title" />
            <RadioGroup
                android:id="@+id/mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <RadioButton
                    android:id="@+id/mode_strict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/mode_strict"
                    android:textColor="@color/text"
                    android:textSize="15sp" />
                <RadioButton
                    android:id="@+id/mode_ports"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/mode_ports"
                    android:textColor="@color/text"
                    android:textSize="15sp" />
            </RadioGroup>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/mode_hint"
                android:textColor="@color/text2"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- start / stop -->
        <Button
            android:id="@+id/btn_toggle"
            style="@style/FilledButton"
            android:layout_marginTop="16dp"
            android:text="@string/start" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/match"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text2"
            android:textSize="14sp" />

        <!-- servers -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/Label" android:text="@string/servers_title" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btn_ping"
                    style="@style/TextButton"
                    android:layout_height="36dp"
                    android:textSize="13sp"
                    android:text="@string/ping_button" />
                <Button
                    android:id="@+id/btn_show"
                    style="@style/TextButton"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:textSize="13sp"
                    android:text="@string/show_all" />
                <Button
                    android:id="@+id/btn_clear"
                    style="@style/TextButton"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:textSize="13sp"
                    android:text="@string/clear" />
            </LinearLayout>
            <TextView
                android:id="@+id/ping_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/pinging"
                android:textColor="@color/text2"
                android:textSize="12sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/servers_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/servers_empty"
                android:textColor="@color/text2"
                android:textSize="13sp" />
            <LinearLayout
                android:id="@+id/servers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- log -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/Label" android:text="@string/log_title" />
            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_rules"
            style="@style/TextButton"
            android:layout_marginTop="12dp"
            android:text="@string/rules_button" />

        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/text2"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
